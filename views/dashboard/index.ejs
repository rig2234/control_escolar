<section id="reportes" class="section">
    <div class="view-header">
        <h3>Reportes</h3>
        <button class="btn-primary" id="btnGenerarReporte">📊 Generar Reporte</button>
    </div>

    <div class="reports-grid">
        <div class="report-card">
            <h4>Reporte de Asistencia</h4>
            <p>Análisis de asistencia por estudiante y periodo</p>
            <button class="btn-secondary">Descargar</button>
        </div>

        <div class="report-card">
            <h4>Reporte de Calificaciones</h4>
            <p>Resumen de calificaciones por materia y grado</p>
            <button class="btn-secondary">Descargar</button>
        </div>

        <div class="report-card">
            <h4>Reporte de Desempeño</h4>
            <p>Evaluación del desempeño académico general</p>
            <button class="btn-secondary">Descargar</button>
        </div>

        <div class="report-card">
            <h4>Reporte de Tareas</h4>
            <p>Registro de tareas asignadas y entregadas</p>
            <button class="btn-secondary">Descargar</button>
        </div>
    </div>
</section>

<section id="comunicacion" class="section">
    <div class="view-header">
        <h3>Comunicación</h3>
        <button class="btn-primary" id="btnNuevoMensaje">✉ Nuevo Mensaje</button>
    </div>

    <div class="messaging-container">
        <div class="messages-list">
            <div class="message-item active">
                <div class="message-avatar">JG</div>
                <div class="message-info">
                    <h4>Juan García</h4>
                    <p>¿Cuándo es el próximo examen?</p>
                </div>
                <span class="message-time">2h</span>
            </div>

            <div class="message-item">
                <div class="message-avatar">ML</div>
                <div class="message-info">
                    <h4>María López</h4>
                    <p>Entregué el proyecto</p>
                </div>
                <span class="message-time">4h</span>
            </div>

            <div class="message-item">
                <div class="message-avatar">CR</div>
                <div class="message-info">
                    <h4>Carlos Rodríguez</h4>
                    <p>¿Puedo entregar la tarea mañana?</p>
                </div>
                <span class="message-time">1d</span>
            </div>
        </div>

        <div class="message-chat">
            <div class="chat-header">
                <h4>Juan García</h4>
            </div>
            <div class="chat-messages">
                <div class="message-bubble other">
                    <p>¿Cuándo es el próximo examen?</p>
                    <small>10:30 AM</small>
                </div>
                <div class="message-bubble mine">
                    <p>El próximo examen es el viernes 19 de septiembre</p>
