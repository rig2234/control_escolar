            <div class="chat-input">
                <input type="text" placeholder="Escribe un mensaje...">
                <button>Enviar</button>
            </div>
        </div>
    </div>
</section>

<section id="configuracion" class="section">
    <div class="view-header">
        <h3>Configuración</h3>
    </div>

    <div class="settings-container">
        <div class="settings-card">
            <h4>Mi Perfil</h4>
            <div class="profile-info">
                <p><strong>Usuario:</strong> <span id="profileLogin">usuario</span></p>
                <p><strong>ID:</strong> <span id="profileId">-</span></p>
                <p><strong>Estado:</strong> <span id="profileStatus">Activo</span></p>
                <p><strong>Fecha de Registro:</strong> <span id="profileDate">-</span></p>
            </div>
            <button class="btn-primary" id="btnCambiarContraseña">
                Cambiar Contraseña
            </button>
        </div>

        <div class="settings-card">
            <h4>Preferencias</h4>
            <div class="preference-item">
                <label>
                    <input type="checkbox" checked>
                    <span>Recibir notificaciones por email</span>
                </label>
            </div>
            <div class="preference-item">
                <label>
                    <input type="checkbox" checked>
                    <span>Mostrar eventos en calendario</span>
                </label>
            </div>
            <div class="preference-item">
                <label>
                    <input type="checkbox">
                    <span>Modo oscuro</span>
                </label>
            </div>
        </div>

        <div class="settings-card">
            <h4>Seguridad</h4>
            <p style="margin-bottom: 15px; color: #666;">
                Última conexión: 2 horas atrás desde Chrome en Windows
            </p>
            <button class="btn-secondary">Ver todas las sesiones</button>
        </div>
    </div>
</section>