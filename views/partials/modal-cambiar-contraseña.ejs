<div id="modalCambiarContraseña" class="modal hidden">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Cambiar Contraseña</h3>
            <button class="btn-close" id="btnCerrarModal">&times;</button>
        </div>
        <form id="formCambiarContraseña" class="modal-form">
            <div class="form-group">
                <label for="passwordActual">Contraseña Actual</label>
                <input type="password" id="passwordActual" name="passwordActual" required>
                <span class="error-message" id="passwordActualError"></span>
            </div>

            <div class="form-group">
                <label for="passwordNueva">Nueva Contraseña</label>
                <input type="password" id="passwordNueva" name="passwordNueva" required>
                <span class="error-message" id="passwordNuevaError"></span>
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirmar Contraseña</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required>
                <span class="error-message" id="confirmPasswordError"></span>
            </div>

            <div class="modal-buttons">
                <button type="button" class="btn-secondary" id="btnCancelar">Cancelar</button>
                <button type="submit" class="btn-primary">Guardar Cambios</button>
            </div>

            <span class="error-message" id="formError"></span>
            <span class="success-message" id="successMessage"></span>
        </form>
    </div>
</div>