<header class="header">
    <div class="header-left">
        <h2 id="pageTitle"><%= pageTitle || 'Dashboard' %></h2>
    </div>
    <div class="header-right">
        <div class="user-info">
            <div class="user-avatar">
                <span id="userInitial">R</span>
            </div>
            <div class="user-details">
                <p class="user-name" id="userName">Usuario</p>
                <p class="user-role" id="userRole">Estudiante</p>
            </div>
        </div>
    </div>
</header>