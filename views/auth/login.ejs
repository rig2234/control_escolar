<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Control Escolar</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="login-container">
        <div class="login-box">
            <div class="login-header">
                <h1>Control Escolar</h1>
                <p>Iniciar Sesión</p>
            </div>

            <form id="loginForm" class="login-form">
                <div class="form-group">
                    <label for="login">Usuario</label>
                    <input 
                        type="text" 
                        id="login" 
                        name="login" 
                        placeholder="Ingresa tu usuario" 
                        required
                    >
                    <span class="error-message" id="loginError"></span>
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <div class="password-container">
                        <input 
                            type="password" 
                            id="password" 
                            name="password" 
                            placeholder="Ingresa tu contraseña" 
                            required
                        >
                        <button 
                            type="button" 
                            class="toggle-password" 
                            id="togglePassword"
                        >
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <span class="error-message" id="passwordError"></span>
                </div>

                <div class="form-group checkbox">
                    <input type="checkbox" id="recuerdame" name="recuerdame">
                    <label for="recuerdame">Recuérdame</label>
                </div>

                <button type="submit" class="btn-login" id="loginBtn">
                    <span>Iniciar Sesión</span>
                    <span class="loader hidden" id="loader"></span>
                </button>

                <span class="error-message" id="formError"></span>
                <span class="success-message" id="successMessage"></span>
            </form>

            <div class="login-footer">
                <p>¿Olvidaste tu contraseña? <a href="#" class="link">Recuperarla</a></p>
                <p>¿No tienes cuenta? <a href="/registro" class="link">Regístrate aquí</a></p>
            </div>
        </div>

        <div class="login-side">
            <div class="side-content">
                <h2>¡Bienvenido!</h2>
                <p>Gestiona la educación de forma eficiente con nuestro sistema de control escolar.</p>
                <ul class="features">
                    <li>📚 Gestión de estudiantes</li>
                    <li>📊 Calificaciones en línea</li>
                    <li>📅 Horarios y asistencia</li>
                    <li>💬 Comunicación con padres</li>
                </ul>
            </div>
        </div>
    </div>

    <script src="/js/login.js"></script>
</body>
</html>